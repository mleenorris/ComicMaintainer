# ComicMaintainer .NET Docker Environment Variables

# Directory Configuration
WATCHED_DIR=/watched_dir
DUPLICATE_DIR=/duplicates
CONFIG_DIR=/Config

# System Configuration
# User/Group ID for file operations (set to match your host user)
# To find your user ID: id -u
# To find your group ID: id -g
PUID=99
PGID=100
MAX_WORKERS=4
DB_CACHE_SIZE_MB=64

# Security Configuration (REQUIRED for production)
# Generate a secure random string for JWT_SECRET (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=ChangeThisToASecureRandomString-MustBeAtLeast32CharactersLong!!

# Admin User Configuration (change for production)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@comicmaintainer.local
ADMIN_PASSWORD=Admin123!

# CORS Configuration (IMPORTANT for production)
# Comma-separated list of allowed origins
# Examples:
#   For localhost development: http://localhost:5000,https://localhost:5000
#   For production: https://comics.example.com,https://www.comics.example.com
#   For reverse proxy: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://localhost:5000

# External Series Metadata Providers (all optional)
# When enabled, ComicMaintainer queries these providers to enrich series with
# canonical titles and aliases. Providers are tried in order:
# ComicVine -> MangaDex -> Suwayomi.

# ComicVine (Western comics; requires a free API key from https://comicvine.gamespot.com/api/)
# ENABLE_EXTERNAL_SERIES_METADATA=true
# COMICVINE_API_KEY=
# COMICVINE_BASE_URL=https://comicvine.gamespot.com/api

# MangaDex (manga, manhwa, manhua; no API key required)
# ENABLE_MANGADEX_METADATA=true
# MANGADEX_BASE_URL=https://api.mangadex.org

# Suwayomi sidecar (Tachiyomi/Mihon-derived server with many community-maintained
# source extensions: MangaDex, Comick, Bato, Weebcentral, MangaPlus, etc.)
# Run Suwayomi as a separate container (see docker-compose.dotnet.yml for an
# example sidecar block) and install your preferred source extensions through
# its web UI before enabling this provider.
# ENABLE_SUWAYOMI_METADATA=true
# SUWAYOMI_BASE_URL=http://suwayomi:4567
# Comma-separated list of numeric source IDs to query (find them in Suwayomi's
# Sources screen). Leave blank to query every installed source (slower).
# SUWAYOMI_SOURCE_IDS=
# Only required if the Suwayomi sidecar has Basic auth enabled.
# SUWAYOMI_USERNAME=
# SUWAYOMI_PASSWORD=

# Note: Never commit the actual .env file with secrets to version control
# Copy this file to .env and update with your actual values
