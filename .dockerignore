# The image is built from src/ and entrypoint.dotnet.sh (see Dockerfile.dotnet). Everything else is kept out of the
# build context, so it is not sent to the builder and cannot invalidate the cached layers.

# Local build output. A host build's bin/ and obj/ (including an obj/project.assets.json with host paths) would
# otherwise be copied over the restore done in the image, and would change the COPY src/ layer on every build.
**/bin/
**/obj/
**/TestResults/
coverage/

# Not part of the server image
tests/
node_modules/
src/ComicMaintainer.MauiApp/
scripts/
docs/

# Git, CI and editor files
.git
.gitignore
.gitattributes
.github
.vs
.vscode
.idea
.config
*.swp
*.swo
*~
*.code-workspace
*.user

# Documentation
*.md
LICENSE*

# Local environment and secrets: never sent to the builder
.env
.env.*
*.pfx
*.pem
*.key

# Logs, OS files and temporary files
*.log
**/.DS_Store
**/Thumbs.db
*.tmp
