# ComicMaintainer .NET Docker Environment Variables

# Directory Configuration
WATCHED_DIR=/watched_dir
DUPLICATE_DIR=/duplicates
CONFIG_DIR=/Config

# System Configuration
# User/Group ID for file operations (set to match your host user)
# To find your user ID: id -u
# To find your group ID: id -g
PUID=99
PGID=100
MAX_WORKERS=4
DB_CACHE_SIZE_MB=64

# Security Configuration (REQUIRED for production)
# Generate a secure random string for JWT_SECRET (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=ChangeThisToASecureRandomString-MustBeAtLeast32CharactersLong!!

# Admin User Configuration (change for production)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@comicmaintainer.local
ADMIN_PASSWORD=Admin123!

# CORS Configuration (IMPORTANT for production)
# Comma-separated list of allowed origins
# Examples:
#   For localhost development: http://localhost:5000,https://localhost:5000
#   For production: https://comics.example.com,https://www.comics.example.com
#   For reverse proxy: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://localhost:5000

# External Series Metadata (optional)
# When enabled, ComicMaintainer queries ComicVine / MangaDex / AniList for
# canonical series titles and aliases.
ENABLE_EXTERNAL_SERIES_METADATA=false
# COMICVINE_API_KEY=your-key
# COMICVINE_BASE_URL=https://comicvine.gamespot.com/api
# ENABLE_MANGADEX_METADATA=false
# MANGADEX_BASE_URL=https://api.mangadex.org
# ENABLE_ANILIST_MANHWA_METADATA=false
# ENABLE_ANILIST_MANGA_METADATA=false
# ANILIST_BASE_URL=https://graphql.anilist.co

# When external metadata is enabled, also download a series-level cover
# image from the matched provider and persist it under
# {CONFIG_DIR}/series-images/ for use on series cards. Defaults to true.
DOWNLOAD_EXTERNAL_SERIES_IMAGES=true
# SERIES_IMAGE_CACHE_DIR=/Config/series-images

# Note: Never commit the actual .env file with secrets to version control
# Copy this file to .env and update with your actual values
