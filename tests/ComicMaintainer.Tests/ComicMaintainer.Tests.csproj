<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The [LibraryImport] source generator emits unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The Android app needs a workload to build, but its API, session and view-model code is free of MAUI types. It is
    compiled here as well, so that it runs against the real API. Only Services/Platform and the pages stay out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\..\src\ComicMaintainer.MauiApp\Models\*.cs" LinkBase="AndroidApp\Linked\Models" />
    <Compile Include="..\..\src\ComicMaintainer.MauiApp\Services\*.cs" LinkBase="AndroidApp\Linked\Services" />
    <Compile Include="..\..\src\ComicMaintainer.MauiApp\ViewModels\*.cs" LinkBase="AndroidApp\Linked\ViewModels" />
    <Compile Include="..\..\src\ComicMaintainer.MauiApp\Extensions\*.cs" LinkBase="AndroidApp\Linked\Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ComicMaintainer.Core\ComicMaintainer.Core.csproj" />
    <ProjectReference Include="..\..\src\ComicMaintainer.WebApi\ComicMaintainer.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
