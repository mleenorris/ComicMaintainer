# ComicMaintainer .NET Docker Environment Variables

# Directory Configuration
WATCHED_DIR=/watched_dir
DUPLICATE_DIR=/duplicates
CONFIG_DIR=/Config

# System Configuration
# User/Group ID for file operations (set to match your host user)
# To find your user ID: id -u
# To find your group ID: id -g
PUID=99
PGID=100
MAX_WORKERS=4
DB_CACHE_SIZE_MB=64

# Security Configuration (REQUIRED for production)
# Generate a secure random string for JWT_SECRET (minimum 32 characters)
# Example: openssl rand -base64 48
JWT_SECRET=ChangeThisToASecureRandomString-MustBeAtLeast32CharactersLong!!

# Admin User Configuration (change for production)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@comicmaintainer.local
ADMIN_PASSWORD=Admin123!

# CORS Configuration (IMPORTANT for production)
# Comma-separated list of allowed origins
# Examples:
#   For localhost development: http://localhost:5000,https://localhost:5000
#   For production: https://comics.example.com,https://www.comics.example.com
#   For reverse proxy: https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://localhost:5000

# External Series Metadata (optional)
# When enabled, ComicMaintainer queries ComicVine / MangaDex / AniList for
# canonical series titles and aliases.
ENABLE_EXTERNAL_SERIES_METADATA=false
# COMICVINE_API_KEY=your-key
# COMICVINE_BASE_URL=https://comicvine.gamespot.com/api
# ENABLE_MANGADEX_METADATA=false
# MANGADEX_BASE_URL=https://api.mangadex.org
# ENABLE_ANILIST_MANHWA_METADATA=false
# ENABLE_ANILIST_MANGA_METADATA=false
# ANILIST_BASE_URL=https://graphql.anilist.co
# Client-side rate limits applied to outbound provider requests so we stay
# under each provider's published quota (MangaDex: 5 req/s per IP;
# AniList: 90 req/min documented, currently degraded to 30 req/min).
# Defaults leave headroom; lower if you start seeing 429 responses.
# MANGADEX_REQUESTS_PER_SECOND=4
# ANILIST_REQUESTS_PER_MINUTE=28

# Suwayomi server used to download the issues a series is missing.
# ENABLE_SUWAYOMI=false
# SUWAYOMI_BASE_URL=http://localhost:4567
# SUWAYOMI_USERNAME=
# SUWAYOMI_PASSWORD=
# Import Suwayomi's downloads into the library: the "Suwayomi Download Import"
# scheduled job (every 15 minutes) moves finished chapters from
# SUWAYOMI_DOWNLOADS_DIR/<source>/<series>/<chapter>.cbz to
# <series folder>/<chapter>.cbz, using the series' existing library folder when
# it has one, or a new folder in SUWAYOMI_IMPORT_DIR. Mount Suwayomi's
# downloads/mangas folder outside the watched directory, writable by PUID/PGID,
# and enable "Save as CBZ archive" in Suwayomi. Also settable in the web UI.
# SUWAYOMI_DOWNLOADS_DIR=/suwayomi/downloads/mangas
# Relative to WATCHED_DIR (e.g. Manga); blank means WATCHED_DIR itself.
# SUWAYOMI_IMPORT_DIR=

# When external metadata is enabled, also download a series-level cover
# image from the matched provider and persist it under
# {CONFIG_DIR}/series-images/ for use on series cards. Defaults to true.
DOWNLOAD_EXTERNAL_SERIES_IMAGES=true
# SERIES_IMAGE_CACHE_DIR=/Config/series-images
# Persisted cover images are capped at this many bytes (default 5 MiB). A larger
# source image is downloaded (up to SERIES_IMAGE_MAX_DOWNLOAD_BYTES) and then
# downscaled to fit, so an oversized source doesn't block the cover.
# SERIES_IMAGE_MAX_BYTES=5242880
# SERIES_IMAGE_MAX_DOWNLOAD_BYTES=26214400
# Largest width/height (px) a downscaled cover is resized to (default 2048).
# SERIES_IMAGE_MAX_DIMENSION=2048

# Email to E-Reader (optional)
# Email delivery stays disabled until SMTP_HOST and EMAIL_FROM_ADDRESS are set.
# See docs/EMAIL_DELIVERY.md for details.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=comics@example.com
# SMTP_PASSWORD=your-app-password
# Implicit TLS (SMTPS, usually port 465). Leave false for port 587, which uses
# STARTTLS. Defaults to false.
# SMTP_USE_SSL=false
# Allow a plaintext connection when the server does not advertise STARTTLS.
# Only enable for a trusted local relay; defaults to false (STARTTLS required).
# SMTP_ALLOW_INSECURE=false
# EMAIL_FROM_ADDRESS=comics@example.com
# EMAIL_FROM_NAME=ComicMaintainer
# EMAIL_MAX_ATTACHMENT_MB=25
# Rate limit for comic emails; 0 (the default) disables each limit.
# Deliveries over the limit stay pending and go out when it allows.
# EMAIL_MAX_SENDS_PER_HOUR=0
# EMAIL_MAX_SENDS_PER_DAY=0
# EMAIL_MIN_SECONDS_BETWEEN_SENDS=0

# Monitoring (optional) - OpenTelemetry metrics are always collected in-process.
# Expose them for Prometheus scraping at /metrics (default false):
# TELEMETRY__PROMETHEUSENABLED=false
# When set, /metrics requires "Authorization: Bearer <token>". When empty the
# endpoint is anonymous - restrict /metrics at your reverse proxy instead.
# TELEMETRY__METRICSTOKEN=
# Push metrics and traces to an OpenTelemetry collector (OTLP). Unset = disabled.
# The other standard OTEL_EXPORTER_OTLP_* / OTEL_SERVICE_NAME variables apply too.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# API documentation - serve Swagger UI at /swagger outside Development (default false)
# API__ENABLESWAGGER=false

# Database backups - written by the daily "database-backup" scheduled job and
# the admin-only /api/backups endpoints. Defaults: {CONFIG_DIR}/backups, keep 7.
# Backups contain password hashes and stored credentials; keep them private.
# APPSETTINGS__DATABASEBACKUPDIRECTORY=/Config/backups
# APPSETTINGS__DATABASEBACKUPRETENTION=7

# Note: Never commit the actual .env file with secrets to version control
# Copy this file to .env and update with your actual values
