<Project>
  <!--
    CI builds the shipped projects with -p:StrictWarnings=true, which turns their compiler and analyzer warnings
    (nullable warnings included) into errors, so warnings cannot pile up unnoticed. It is a property rather than the
    default so a local build, or a newer SDK that adds warnings, still compiles. This file applies only to the
    projects under src/; the test projects keep their warnings as warnings for now.
  -->
  <PropertyGroup Condition="'$(StrictWarnings)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Known-vulnerable packages (NuGet audit) are left to the security scan workflow, which fails on high and critical
      advisories. Failing every build here would also stop unrelated pull requests on a low or moderate advisory in
      a transitive package, when vulnerability data cannot be fetched (NU1900), or when a source offers none (NU1905).
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
