{
	"info": {
		"_postman_id": "comic-maintainer-api",
		"name": "ComicMaintainer API",
		"description": "Complete API collection for ComicMaintainer .NET WebAPI. This collection covers all endpoints for managing comic files, processing jobs, authentication, and settings.\n\n## Setup\n1. Import this collection into Postman\n2. Set up the environment variables (base_url, jwt_token)\n3. Use the Auth endpoints to login and get a JWT token\n4. Most endpoints require authentication\n\n## Environment Variables\n- base_url: http://localhost:5000 (or your API base URL)\n- jwt_token: Your JWT token from login (will be set automatically after login)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Check Setup Required",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/setup-required",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "setup-required"]
						},
						"description": "Check if initial admin setup is required (no users exist yet)"
					},
					"response": []
				},
				{
					"name": "Setup Admin User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Note: This endpoint is typically only available when no users exist",
									"if (pm.response.code === 200) {",
									"    console.log('Admin user created successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\",\n  \"email\": \"admin@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/setup",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "setup"]
						},
						"description": "Create the first admin user. Only works if no users exist yet."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extract token from response and save to environment",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set('jwt_token', jsonData.token);",
									"        console.log('JWT token saved to environment');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login to get a JWT token. Token is automatically saved to environment variable."
					},
					"response": []
				},
