{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "WatchedDirectory": "/tmp/comics_test",
    "ConfigDirectory": "/tmp/config_test",
    "FilenameFormat": "{series} - Chapter {issue}",
    "LogMaxBytes": 10485760,
    "IssueNumberPadding": 3,
    "DatabaseCleanupIntervalHours": 24,
    "WatcherEnableRename": true,
    "WatcherEnableNormalize": true
  },
  "JwtSettings": {
    "SecretKey": "test-secret-key-for-jwt-token-generation-minimum-32-chars",
    "Issuer": "ComicMaintainer",
    "Audience": "ComicMaintainerClient",
    "ExpirationMinutes": 60
  },
  "AutheliaSettings": {
    "Enabled": false
  }
}
