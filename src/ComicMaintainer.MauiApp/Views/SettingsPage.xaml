<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ComicMaintainer.MauiApp.ViewModels"
             x:Class="ComicMaintainer.MauiApp.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="⚙️ Settings"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a1a}">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Server Configuration Card -->
            <Frame BorderColor="{AppThemeBinding Light=#ecf0f1, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌐 Server Configuration"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2c3e50, Dark=#d1d5db}" />

                    <Label Text="Server URL"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#7f8c8d, Dark=#9ca3af}" />
                    
                    <Entry Text="{Binding ServerUrl}"
                           Placeholder="http://192.168.1.100:5000"
                           Keyboard="Url"
                           FontSize="14"
                           BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#252525}"
                           TextColor="{AppThemeBinding Light=#333, Dark=#e5e5e5}" />

                    <Label Text="Enter the URL of your ComicMaintainer server"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#95a5a6, Dark=#6b7280}" />

                    <Button Text="🔗 Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            HorizontalOptions="Fill"
                            Margin="0,5,0,0" />

                    <Label Text="{Binding TestResult}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           IsVisible="{Binding TestResult, Converter={StaticResource StringNotEmptyConverter}}"
                           TextColor="{AppThemeBinding Light=#2c3e50, Dark=#d1d5db}" />

                    <Button Text="💾 Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HorizontalOptions="Fill"
                            Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Examples Card -->
            <Frame BorderColor="{AppThemeBinding Light=#ecf0f1, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📝 Example Server URLs"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2c3e50, Dark=#d1d5db}" />
                    
                    <Label FontSize="13"
                           TextColor="{AppThemeBinding Light=#333, Dark=#e5e5e5}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="• Local: " FontAttributes="Bold" />
                                <Span Text="http://localhost:5000&#x0a;" />
                                <Span Text="• Network: " FontAttributes="Bold" />
                                <Span Text="http://192.168.1.100:5000&#x0a;" />
                                <Span Text="• Domain: " FontAttributes="Bold" />
                                <Span Text="https://comics.example.com" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Theme Toggle Card -->
            <Frame BorderColor="{AppThemeBinding Light=#ecf0f1, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                   HasShadow="True">
                <HorizontalStackLayout Spacing="15">
                    <Label Text="🌓 Dark Mode"
                           FontSize="16"
                           VerticalOptions="Center"
                           HorizontalOptions="StartAndExpand"
                           TextColor="{AppThemeBinding Light=#2c3e50, Dark=#d1d5db}" />
                    <Switch IsToggled="{Binding IsDarkMode}"
                            OnColor="#28a745"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- About Section -->
            <Frame BorderColor="{AppThemeBinding Light=#ecf0f1, Dark=#404040}"
                   Padding="15"
                   CornerRadius="8"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1a1a1a}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ℹ️ About"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2c3e50, Dark=#d1d5db}" />
                    <Label Text="ComicMaintainer Mobile"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#333, Dark=#e5e5e5}" />
                    <Label Text="Version 2.0.1"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#7f8c8d, Dark=#9ca3af}" />
                    <Label Text="Manage your comic collection on the go"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#95a5a6, Dark=#6b7280}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
