# Dockerfile for .NET ComicMaintainer Web Application
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 5000

# Install system dependencies for file handling, unrar, gosu for user switching, and curl
# for the container health check.
RUN apt-get update && apt-get install -y \
    unrar-free \
    p7zip-full \
    gosu \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Pin the build stage to the machine doing the building rather than the image being produced.
# Without this, building the arm64 image on an amd64 runner would run the whole SDK under
# QEMU emulation, which is dramatically slower. The compiler runs natively and is told which
# runtime to emit via TARGETARCH instead.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

# Copy solution and project files
COPY ["src/ComicMaintainer.Core/ComicMaintainer.Core.csproj", "src/ComicMaintainer.Core/"]
COPY ["src/ComicMaintainer.WebApi/ComicMaintainer.WebApi.csproj", "src/ComicMaintainer.WebApi/"]

# Restore dependencies for each project
WORKDIR "/src/src/ComicMaintainer.Core"
RUN dotnet restore "ComicMaintainer.Core.csproj" -a "${TARGETARCH}"
WORKDIR "/src/src/ComicMaintainer.WebApi"
RUN dotnet restore "ComicMaintainer.WebApi.csproj" -a "${TARGETARCH}"

# Copy source files
WORKDIR "/src"
COPY ["src/", "src/"]

# Build the application
WORKDIR "/src/src/ComicMaintainer.WebApi"
RUN dotnet build "ComicMaintainer.WebApi.csproj" -c Release -a "${TARGETARCH}" -o /app/build

FROM build AS publish
ARG TARGETARCH
RUN dotnet publish "ComicMaintainer.WebApi.csproj" -c Release -a "${TARGETARCH}" -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create config directory for persistent data
RUN mkdir -p /Config && chmod 755 /Config

# Set default environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV WATCHED_DIR=/watched_dir
ENV DUPLICATE_DIR=/duplicates
ENV CONFIG_DIR=/Config
ENV PUID=99
ENV PGID=100
ENV MAX_WORKERS=4
ENV DB_CACHE_SIZE_MB=64

# Security note: These default values should be overridden in production
# Use Docker secrets or environment variables for sensitive data
ENV ADMIN_USERNAME=admin
ENV ADMIN_EMAIL=admin@comicmaintainer.local

# Copy entrypoint script
COPY entrypoint.dotnet.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create necessary directories with default permissions
# User/group will be created dynamically based on PUID/PGID at runtime
RUN mkdir -p /watched_dir /duplicates /Config && \
    chmod -R 755 /watched_dir /duplicates /Config

# Expose web interface port
EXPOSE 5000

# Report container health from the application's own liveness probe. "/health" is used rather
# than "/health/ready" deliberately: readiness also checks the database, and a transient
# database problem should not make Docker restart an otherwise healthy process.
# start-period covers first-run startup, which applies migrations.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent --show-error http://localhost:5000/health || exit 1

# Use entrypoint script to handle dynamic user creation and permission management
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
