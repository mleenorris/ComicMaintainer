# Dockerfile for .NET ComicMaintainer Web Application
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 5000

# gosu switches from root to the PUID user after the entrypoint has prepared /Config, and curl runs the container
# health check. Archives (ZIP and RAR) are read in-process by SharpCompress, so no unrar or 7-Zip tools are installed;
# recommended packages are left out to keep the image, and the CVEs scanned in it, small. The upgrade applies OS
# security fixes published since the base image was built, which the image scan in CI would otherwise fail on.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        gosu \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Pin the build stage to the machine doing the building rather than the image being produced.
# Without this, building the arm64 image on an amd64 runner would run the whole SDK under
# QEMU emulation, which is dramatically slower. The compiler runs natively and is told which
# runtime to emit via TARGETARCH instead.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

# Copy the project files first, so the restore layers are reused until a project file changes.
COPY ["src/ComicMaintainer.Core/ComicMaintainer.Core.csproj", "src/ComicMaintainer.Core/"]
COPY ["src/ComicMaintainer.WebApi/ComicMaintainer.WebApi.csproj", "src/ComicMaintainer.WebApi/"]

# Restore dependencies for each project
WORKDIR "/src/src/ComicMaintainer.Core"
RUN dotnet restore "ComicMaintainer.Core.csproj" -a "${TARGETARCH}"
WORKDIR "/src/src/ComicMaintainer.WebApi"
RUN dotnet restore "ComicMaintainer.WebApi.csproj" -a "${TARGETARCH}"

# Copy source files. .dockerignore keeps local bin/ and obj/ folders out, so a host build neither ends up in the
# image nor replaces the restore above.
WORKDIR "/src"
COPY ["src/", "src/"]

# Publish compiles the application; a separate build step would only compile it twice.
FROM build AS publish
ARG TARGETARCH
WORKDIR "/src/src/ComicMaintainer.WebApi"
RUN dotnet publish "ComicMaintainer.WebApi.csproj" -c Release -a "${TARGETARCH}" --no-restore -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Set default environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV WATCHED_DIR=/watched_dir
ENV DUPLICATE_DIR=/duplicates
ENV CONFIG_DIR=/Config
ENV PUID=99
ENV PGID=100
# The entrypoint only checks that PUID can write to WATCHED_DIR and DUPLICATE_DIR, and gives PUID one that is empty
# and owned by root. Set to true to have it give everything in them to PUID:PGID with owner and group read/write
# access (u+rwX,g+rwX) at start.
ENV FIX_LIBRARY_PERMISSIONS=false

# Security note: These default values should be overridden in production
# Use Docker secrets or environment variables for sensitive data
ENV ADMIN_USERNAME=admin
ENV ADMIN_EMAIL=admin@comicmaintainer.local

# Copy entrypoint script
COPY entrypoint.dotnet.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create the mount points. User/group are created at runtime from PUID/PGID, and the entrypoint gives /Config to
# them; a library folder mounted from the host keeps the host's ownership.
RUN mkdir -p /watched_dir /duplicates /Config && \
    chmod 755 /watched_dir /duplicates /Config

# Report container health from the application's own liveness probe. "/health" is used rather
# than "/health/ready" deliberately: readiness also checks the database, and a transient
# database problem should not make Docker restart an otherwise healthy process.
# start-period covers first-run startup, which applies migrations.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent --show-error http://localhost:5000/health || exit 1

# Use entrypoint script to handle dynamic user creation and permission management
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
